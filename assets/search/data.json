[
  {{ range $index, $page := (where .Site.Pages "Params.geekdocProtected" "ne" true) }}
    {{ if ne $index 0 }},{{ end }}
    {
      "id": {{ $index }},
      "href": "{{ $page.RelPermalink }}",
      "title": {{ (partial "utils/title" $page) | jsonify }},
      "parent": {{ with $page.Parent }}{{ (partial "utils/title" .) | jsonify }}{{ else }}""{{ end }},
      {{/* Tags are folded into the indexed "content" field so they are searchable.
           The bundled flexsearch hardcodes its index to title/content/description, so
           there is no config way to index a separate "tags" field. */}}
      "content": {{ printf "%s %s" $page.Plain (delimit (default (slice) $page.Params.tags) " ") | jsonify }},
      "description": {{ $page.Summary | plainify | jsonify }}
    }
  {{ end }}
]
